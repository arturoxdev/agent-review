# ---------------------------------------------------------------------------
# Punto — variables de entorno
#
# Copia este archivo a `.env` en la RAÍZ del repo:  cp .env.example .env
# `.env` está en .gitignore; `.env.example` sí se commitea.
#
# `next dev` corre desde apps/web y lee `apps/web/.env`, que es un symlink a
# este `.env` de la raíz. Si el symlink no existe, créalo:
#   ln -s ../../.env apps/web/.env
#
# Estas doce son TODAS las variables que lee el código. No hay más.
# ---------------------------------------------------------------------------

# Connection string de Neon Postgres. REQUERIDA para todo lo que toque la base.
# De dónde sale: https://console.neon.tech → tu proyecto → Connect →
# "Connection string" (elige la pooled, la del host con `-pooler`).
# Debe terminar en `?sslmode=require`.
# Formato: postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
#
# Sin ella las rutas públicas que no tocan Postgres siguen arrancando, pero el
# Panel no renderiza ni cae a fixtures.
DATABASE_URL=

# Origen público de Punto. REQUERIDA.
# Se usa para construir `snapshotUrl` / `thumbnailUrl` (= {ORIGIN}/api/blobs/{uuid})
# y el link del documento (= {ORIGIN}/s/{publicId}).
# En local: http://localhost:3003 (o el PORT que uses). En prod: https://app.punto.dev
PUNTO_ORIGIN=http://localhost:3003

# Secreto HMAC que firma los PUT de subida de blobs (válidos 15 min, PRD §4.1).
# REQUERIDA. Lo generas tú, no sale de ningún dashboard:  openssl rand -hex 32
# Si lo rotas, las URLs de subida ya emitidas dejan de valer (el embed re-firma solo).
BLOB_UPLOAD_SECRET=

# Secreto HS256 del JWT de Acceso al Panel. REQUERIDA para /app, /login y /signup.
# Genera uno con: openssl rand -base64 32
SESSION_SECRET=

# Carpeta donde se guardan los blobs en disco. OPCIONAL (default: .data/blobs).
# Relativa a apps/web. `.data/` no se commitea.
# Solo se usa cuando NO hay credenciales de R2 (ver el bloque de abajo).
BLOB_DIR=.data/blobs

# Puerto de `next dev` / `next start`. OPCIONAL (default: 3003).
# 3003 para no pelear el 3000 del front que estés revisando.
PORT=3003

# Mismo origen que PUNTO_ORIGIN, pero expuesto al bundle del cliente. OPCIONAL:
# si se omite, cae a PUNTO_ORIGIN.
NEXT_PUBLIC_PUNTO_ORIGIN=http://localhost:3003

# API key pública que usa `/dev/host` (la página dummy del §4.1) para cargar el
# embed. OPCIONAL (default: `pk_dev_armot_local`, que es justo la que crea
# `bun run db:seed`). Cámbiala solo si sembraste otra clave.
NEXT_PUBLIC_PUNTO_DEV_KEY=pk_dev_armot_local

# ---------------------------------------------------------------------------
# Cloudflare R2 — dónde viven los blobs en producción.
#
# Las cuatro van JUNTAS: si están las cuatro, `lib/api/blob-store.ts` escribe y lee
# del bucket; si falta alguna, cae al filesystem de BLOB_DIR. En LOCAL son OPCIONALES
# (y lo normal es dejarlas vacías: el disco basta y no necesitas red).
# En VERCEL son OBLIGATORIAS: allí el filesystem es efímero y un snapshot subido por
# el PUT no existiría cuando llega el GET.
#
# Las URLs públicas NO cambian: siguen siendo {PUNTO_ORIGIN}/api/blobs/{uuid}.
# R2 vive detrás de esa ruta; el bucket no necesita acceso público ni dominio propio.
# ---------------------------------------------------------------------------

# Account ID de Cloudflare.
# De dónde sale: dash.cloudflare.com → R2 → barra lateral, "Account ID".
R2_ACCOUNT_ID=

# Nombre del bucket, p.ej. punto-blobs. Créalo en R2 → Create bucket.
# NO habilites acceso público ni dominio público.
R2_BUCKET=

# Credenciales del token de R2.
# De dónde salen: R2 → Manage API tokens → Create API token, permiso
# "Object Read & Write" limitado a ese bucket. El Secret se muestra UNA sola vez.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
